<Project>
  <PropertyGroup>
    <!--
      Feature switches for trimming / NativeAOT.

      CodeBrix.TomlParse follows the "feature switches" guidance from dotnet/runtime:
      - values are provided to the runtime via runtimeconfig.json using RuntimeHostConfigurationOption
      - values are also provided to the trimmer when Trim="true"
    -->

    <!--
      By default, disable reflection-based serialization when publishing with NativeAOT.
      Consumers can override by setting TomlParseIsReflectionEnabledByDefault explicitly.
    -->
    <TomlParseIsReflectionEnabledByDefault Condition="'$(TomlParseIsReflectionEnabledByDefault)' == '' and ( '$(PublishAot)' == 'true' or '$(NativeAot)' == 'true' )">false</TomlParseIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(TomlParseIsReflectionEnabledByDefault)' != ''">
    <RuntimeHostConfigurationOption Include="CodeBrix.TomlParse.TomlSerializer.IsReflectionEnabledByDefault"
                                   Value="$(TomlParseIsReflectionEnabledByDefault)"
                                   Trim="true" />
  </ItemGroup>
</Project>
